#include "globalDef.h"
#include <iostream>
//#include "kinematics.h"
#include "motionplanning.h"
#include "dynamics.h"
#include "robot.h"
//#define VREP_B0

#ifdef VREP_B0
#include "vrepsimb0.h"
#else
#include "vrepsim.h"
#endif

using namespace std;
using namespace robot;

void printVector(float vec[], int n)
{
    for(int i=0;i<n;i++)
    {
        printf("%0.2f",vec[i]);
        if(i!=n-1)printf("\t");
    }
    printf("\n");
}

int main()
{
    float T_SIM = 0.05f;
    bool ret;

//    robotArm arm;
//    const char filename[] = "./model/iiwa7.urdf";
//    arm.init(filename);
//    //arm.ik()

    //start vrepsim

#ifdef VREP_B0
    vrepsimB0 vrep;
#else
    vrepsim vrep;
#endif
    Vector3d pos,pos0;
    Matrix3d ori;
    VectorNd qres;
    dynamics dyna;
    dyna.init();

    VectorNd q       = VectorNd::Zero (DOFS);
    VectorNd qd      = VectorNd::Zero (DOFS);
    VectorNd qdd     = VectorNd::Zero (DOFS);
    VectorNd tau     = VectorNd::Zero (DOFS);

    VectorNd q_old       = VectorNd::Zero (DOFS);
    VectorNd qd_old      = VectorNd::Zero (DOFS);

    if(vrep.connect("192.168.10.1"))
    {
        //cout << "vrep connected!" << endl;
        //cout << "vrep closed!" << endl;
    }


    //start kinematics
    //kinematics kine;
    float cp[DOFS],jpInit[DOFS];
    float jp[] = { 0,-30.0f * PI / 180.0f,0.0f,-60.0f * PI / 180.0f,0.0f,-30.0f * PI / 180.0f,0.0f};
    //simReal jp[] = { 0,-90.0f * PI / 180.0f,0.0f,-0.0f * PI / 180.0f,0.0f,-0.0f * PI / 180.0f,0.0f};
    //char kinefile[] = "./ikmodel/lbr_iiwa_7_r800.ik";
    //kine.loadFromFile(kinefile);
    //extApi_sleepMs(1000);

    //vrep.getJointPositions(cp);
    //kine.getJointPositions(jpInit);
    //kine.getJointPositions(cp);
    printVector(cp,DOFS);
    motionplanning motion;
    motion.rmlPos(cp,jp,T_SIM,1,2);
    float p[DOFS],v[DOFS],a[DOFS];
    float tstep = T_SIM;

    while(!motion.rmlStep(p,v,a))
    {
        //kine.setJointPositions(p);
        //vrep.setJointPositions(p);
        vrep.setJointTargetPositions(p);
        //vrep.addGraphData(p[1]);
        for(int i=0;i<DOFS;i++)   q[i] = p[i];
        qd = (q - q_old)/tstep;
        qdd = (qd - qd_old)/tstep;
        q_old = q;
        qd_old = qd;
        dyna.inverseDynamics(q,qd,qdd,tau);
        float graphdata[] = {tau[1]};
        vrep.addGraphData(graphdata,1);
        usleep(T_SIM*1000000);
    }

    dyna.setJointPositions(q);
    dyna.getEndPose(pos,ori);
    pos0 = pos;
    dyna.inverseKinematics(pos,ori,qres);
    cout<<qres.transpose()<<endl;

//    C7Vector targetInitTransf;
//    kine.getTargetTransform(&targetInitTransf);
//    C7Vector targetTransf(targetInitTransf);

    float w = 0.1f;
    float t = 0.0,tend = 10.0f;
    int stepCount = 0;

    while(t<tend)
    {
        stepCount++;
        t=stepCount*tstep;
        // Slightly modify the position of the target dummy:
//        targetTransf.X(0) = targetInitTransf.X(0) + 1.0f*simReal(sin(2 * PI * w * t) * 0.2);
//        targetTransf.X(1) = targetInitTransf.X(1) + 0.0f*simReal(sin(4 * PI * w * t) * 0.1);
//        targetTransf.X(2) = targetInitTransf.X(2) + 1.0f*simReal((cos(2 * PI * w * t) - 1) * 0.2);
        pos[0] = pos0[0] + 0.0f*float(sin(2 * PI * w * t) * 0.2);
        pos[1] = pos0[1] + 0.0f*float(sin(4 * PI * w * t) * 0.1);
        pos[2] = pos0[2] + 1.0f*float((cos(2 * PI * w * t) - 1) * 0.2);

//        kine.setTargetTransform(targetTransf);
//        kine.getJointPositions(jp);

        //dyna.setEndPose(pos0,ori);
        dyna.inverseKinematics(pos,ori,qres);

        //for(int i=0;i<DOFS;i++)   q[i] = jp[i];
        q = qres;
        qd = (q - q_old)/tstep;
        qdd = (qd - qd_old)/tstep;
        q_old = q;
        qd_old = qd;
        dyna.inverseDynamics(q,qd,qdd,tau);
        cout << q.transpose() << endl;
        //dyna.forwardDynamics(q,qd,tau,qdd);
        //cout << qdd.transpose() << endl;
        //vrep.setJointPositions(jp);
        for(int i=0;i<DOFS;i++)   jp[i] = q[i];
        vrep.setJointTargetPositions(jp);
        float graphdata[] = {jp[1]};
        vrep.addGraphData(graphdata,1);
        usleep(tstep*1000000);
    }

    //kine.getJointPositions(cp);
    motion.rmlPos(cp,jpInit,T_SIM,1,2);
    while(!motion.rmlStep(p,v,a))
    {
        //kine.setJointPositions(p);
        //vrep.setJointPositions(p);
        vrep.setJointTargetPositions(p);
        for(int i=0;i<DOFS;i++)   q[i] = p[i];
        qd = (q - q_old)/tstep;
        qdd = (qd - qd_old)/tstep;
        q_old = q;
        qd_old = qd;
        dyna.inverseDynamics(q,qd,qdd,tau);
        float graphdata[] = {tau[1]};
        vrep.addGraphData(graphdata,1);
        usleep(T_SIM*1000000);
    }

    //clear all
    //extApi_sleepMs(2000);
    motion.rmlRemove();
    vrep.close();
    cout << "the end!" << endl;
    return 0;
}

